@model Portfolio.Models.LoginViewModel
@{ ViewData["Title"] = "Admin Login"; }
<section class="section narrow center-col">
    <div class="glass panel login reveal">
        <span class="badge">ADMIN MODE</span>
        <h1>Welcome back</h1>
        @if (ViewData["Error"] != null) { <div class="error">@ViewData["Error"]</div> }
        <form asp-action="Login" method="post" class="cform">
            @Html.AntiForgeryToken()
            <label>Username<input asp-for="Username" autocomplete="username" placeholder="admin" /></label>
            <label>Password<input asp-for="Password" type="password" autocomplete="current-password" placeholder="••••••••" /></label>
            <button class="btn btn-primary" type="submit">Login →</button>
        </form>
    </div>
</section>
